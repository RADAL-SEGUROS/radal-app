# Radal backend env for the EC2 dev box. The REAL file lives in S3
# (s3://radal-dev-<account>/deploy/backend.env) and is git-ignored.
# The CI deploy step pulls it onto the box next to docker-compose.yml.

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# RDS MySQL (dev). Format: mysql+pymysql://user:pass@host:3306/dbname
DATABASE_URL=mysql+pymysql://radaladmin:PASSWORD@radal-dev-db.xxxxx.us-east-1.rds.amazonaws.com:3306/radal

# CORS — the dev box origin (public DNS/IP). Comma-separated.
CORS_ORIGINS=http://localhost:5173
