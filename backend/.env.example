# Copy to backend/.env and fill in real values. NEVER commit backend/.env.

# --- Auth / JWT ---
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# Local: sqlite:///./radal.db   AWS: mysql+pymysql://user:pass@host:3306/radal
DATABASE_URL=sqlite:///./radal.db

# --- CORS ---
CORS_ORIGINS=http://localhost:4000

# --- AI (DeepInfra, OpenAI-compatible) ---
AI_BASE_URL=https://api.deepinfra.com/v1/openai
AI_API_KEY=your-deepinfra-api-key-here
AI_MODEL=meta-llama/Llama-3.3-70B-Instruct
AI_TIMEOUT_SECONDS=120

# --- Storage ---
S3_BUCKET=radal-dev-185011028331
S3_REGION=us-east-1

# --- Media (logos / avatars) ---
MEDIA_BACKEND=local
MEDIA_PUBLIC_BASE_URL=/media
MEDIA_S3_PREFIX=media/
MEDIA_MAX_UPLOAD_MB=8

# --- Documents ---
DOCUMENT_S3_PREFIX=documents/
DOCUMENT_MAX_UPLOAD_MB=25
